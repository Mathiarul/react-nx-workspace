{
  "name": "@react-demo/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve e-commerce-web",
    "start:admin": "nx serve admin-portal",
    "start:mobile": "nx serve mobile-app",
    "build": "nx run-many -t build --all",
    "build:apps": "nx run-many -t build -p e-commerce-web admin-portal mobile-app",
    "build:libs": "nx run-many -t build -p @react-demo/types @react-demo/utils @react-demo/ui-components @react-demo/api-client @react-demo/user-management @react-demo/order-management @react-demo/auth @react-demo/products @react-demo/cart",
    "test": "nx run-many -t test --all",
    "test:watch": "nx run-many -t test --all --watch",
    "test:coverage": "nx run-many -t test --all --coverage",
    "lint": "nx run-many -t lint --all",
    "lint:fix": "nx run-many -t lint --all --fix",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "affected:all": "nx affected -t build test lint",
    "affected:build": "nx affected:build",
    "affected:test": "nx affected:test",
    "affected:lint": "nx affected:lint",
    "affected:graph": "nx affected:graph",
    "graph": "nx graph",
    "reset": "nx reset",
    "clean": "nx run-many -t clean --all && nx reset"
  },
  "private": true,
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "7.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@nx/devkit": "22.3.1",
    "@nx/eslint": "22.3.1",
    "@nx/eslint-plugin": "22.3.1",
    "@nx/js": "22.3.1",
    "@nx/playwright": "22.3.1",
    "@nx/react": "22.3.1",
    "@nx/vite": "22.3.1",
    "@nx/web": "22.3.1",
    "@nx/workspace": "22.3.1",
    "@playwright/test": "^1.36.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.7.9",
    "@swc/core": "~1.15.7",
    "@swc/helpers": "~0.5.11",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.1",
    "@types/node": "^25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "ajv": "^8.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "^2.4.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "jiti": "2.6.1",
    "jsdom": "~27.3.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.3.1",
    "prettier": "^3.7.4",
    "tslib": "^2.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.29.0",
    "vite": "^7.3.0",
    "vite-plugin-dts": "~4.5.0",
    "vitest": "^4.0.16"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/shared/*",
    "packages/domain/*",
    "packages/features/*"
  ]
